# Supabase Database URL (Transaction Pooler for Serverless Vercel queries)
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma Migrations / Schema Push
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Admin & Customer Session Authentication Secret
AUTH_SECRET="your-32-character-secret-key"
ADMIN_EMAIL="admin@midnightfuel.com"
ADMIN_PASSWORD="MidnightFuel@2026"

# App Live URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Payment Gateway (Optional)
PAYMENT_GATEWAY_KEY="rzp_test_xxxx"
PAYMENT_GATEWAY_SECRET="xxxx"

# WhatsApp Business API (Optional)
WHATSAPP_API_TOKEN="xxxx"
WHATSAPP_PHONE_NUMBER_ID="xxxx"
